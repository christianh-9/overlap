# Copy to .env for local development. Never commit .env.

# Shows sign-in codes on screen instead of emailing them. Leave off in production.
DEV_MODE=true

# Matches docker-compose.yml
DATABASE_URL=postgresql+psycopg://overlap:overlap@localhost:5432/overlap

# Uncomment and fill in as needed. Production needs JWT_SECRET (32+ random
# characters), RESEND_API_KEY, EMAIL_FROM, SITE_URL, and CORS_ORIGIN.
# JWT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=Overlap <codes@example.com>
# SITE_URL=http://localhost:5173

# JSON lists
# ADMIN_EMAILS=["you@uci.edu"]
# CORS_ORIGIN=["http://localhost:5173"]
# CORS_ORIGIN_REGEX=

# Photos. Without these, uploads are turned off.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
# PHOTO_BUCKET=

# Without CURRENT_TERM the term comes from the academic calendar, e.g. 2026-fall
# CURRENT_TERM=
# TIMEZONE=America/Los_Angeles
# MIN_GAP_MINUTES=30
# MIN_OVERLAP_MINUTES=30
